# Copy to .env and fill in. .env is never committed.

# Vapi private key — Dashboard → API Keys. Used by deploy.mjs.
VAPI_API_KEY=

# Vapi public key — Dashboard → API Keys. Safe in the browser, used by web-demo/index.html.
VAPI_PUBLIC_KEY=

# Set after the first deploy so subsequent runs update in place instead of creating duplicates.
VAPI_ASSISTANT_ID=

# Public HTTPS URL of the tools server, via Cloudflare Tunnel. No trailing slash.
TOOLS_BASE_URL=https://tools.yourdomain.com

# Shared secret sent as x-vapi-secret on every tool call. Generate with: openssl rand -hex 16
# The same value must be exported when running tools-server/server.js.
VAPI_TOOL_SECRET=

# Optional. E.164 number to transfer escalated calls to. If unset, transferCall is omitted from
# the config and escalation still works end to end — ticket, summary, spoken handoff — but does
# not dial out. Phone-number transfer destinations are not expected to work on browser web calls.
TRANSFER_DESTINATION_NUMBER=
